{
  "name": "dim-aegis-overlay",
  "version": "1.9.5",
  "description": "DIM extension for Aegis weapon tiers and roll appraisals",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && node scripts/build.mjs",
    "build:testing": "node scripts/build-testing.mjs",
    "test": "node scripts/test.mjs",
    "package": "node scripts/package.mjs",
    "build:all": "tsc && node scripts/build.mjs && node scripts/package.mjs",
    "preview": "vite preview",
    "test:tooltip-positioning": "node tests/perk-tooltip-positioning.test.cjs",
    "test:unit": "node scripts/test.mjs --unit",
    "test:browser": "node scripts/test-browser.mjs",
    "test:browser:install": "playwright install chromium firefox"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "culori": "4.0.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/culori": "4.0.1",
    "@types/node": "^20.11.0",
    "playwright": "1.62.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11"
  }
}
