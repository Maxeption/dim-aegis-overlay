{
  "manifest_version": 3,
  "name": "DIM Aegis Roll Appraisal Overlay",
  "version": "1.7.1",
  "description": "Display Aegis wishlist rankings directly inside Destiny Item Manager (DIM).",
  "permissions": [
    "storage",
    "alarms",
    "unlimitedStorage",
    "tabs"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://app.destinyitemmanager.com/*",
    "https://beta.destinyitemmanager.com/*",
    "https://www.light.gg/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "icons": {
    "16": "Pouka_Logo_64.png",
    "32": "Pouka_Logo_64.png",
    "48": "Pouka_Logo_64.png",
    "64": "Pouka_Logo_64.png",
    "128": "Pouka_Logo_2000.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "Pouka_Logo_64.png",
      "32": "Pouka_Logo_64.png",
      "48": "Pouka_Logo_64.png",
      "128": "Pouka_Logo_2000.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.destinyitemmanager.com/*",
        "https://beta.destinyitemmanager.com/*"
      ],
      "js": [
        "main-world-content.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://app.destinyitemmanager.com/*",
        "https://beta.destinyitemmanager.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "world": "ISOLATED",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.light.gg/*"
      ],
      "js": [
        "lightgg-main-world.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.light.gg/god-roll/roll-appraiser/",
        "https://www.light.gg/god-roll/roll-appraiser/*"
      ],
      "js": [
        "lightgg-content.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "scoring_engine_and_layout.png",
        "aegis_recommended_perks.png",
        "database_explorer_tab.png",
        "chase_list_tab.png",
        "two-tier-demo.png",
        "database_explorer_btn.png",
        "armor_set_bonus_example.png",
        "wishlist_configuration.png"
      ],
      "matches": [
        "https://app.destinyitemmanager.com/*",
        "https://beta.destinyitemmanager.com/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "dim-aegis-overlay@maxeption.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
